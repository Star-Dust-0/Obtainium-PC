<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ObtainiumPC.Pages.AddAppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,16,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="720"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="12">
            <TextBlock Text="Add App" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Paste the source URL of the app you want to track. GitHub, GitLab, Codeberg, and SourceForge are detected automatically; pick an override source (for example HTML) for anything else." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBox x:Name="UrlBox" PlaceholderText="https://github.com/owner/repository"/>
            <ComboBox x:Name="OverrideSourceCombo" Header="Override source (optional)" MinWidth="260" HorizontalAlignment="Left"/>
            <CheckBox x:Name="TrackOnlyBox" Content="Track only (check versions without downloading)"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AddButton" Content="Add" Style="{StaticResource AccentButtonStyle}" Click="Add_Click"/>
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="18" Height="18" VerticalAlignment="Center"/>
            </StackPanel>
            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" Message=""/>
                        <HyperlinkButton Content="Browse crowdsourced app configs" NavigateUri="https://apps.obtainium.imranr.dev/"/>
                        <Button Content="Supported sources" Click="SupportedSources_Click" HorizontalAlignment="Left"/>

                <TextBlock Text="Search sources (GitHub, GitLab, Codeberg, F-Droid, Uptodown, RuStore, Huawei AppGallery)" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="SearchBox" PlaceholderText="Search for a project" Width="320"/>
                    <Button x:Name="SearchButton" Content="Search" Click="Search_Click"/>
                    <ProgressRing x:Name="SearchRing" IsActive="False" Width="18" Height="18" VerticalAlignment="Center"/>
                </StackPanel>
                <ListView x:Name="SearchResults" MaxHeight="260" IsItemClickEnabled="True" ItemClick="SearchResults_ItemClick" Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="6">
                                <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="{Binding Description}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
    </Grid>
</Page>
