<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ObtainiumPC.Pages.ImportExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="36,24,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Import / Export" Style="{StaticResource TitleTextBlockStyle}"/>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Spacing="12" MaxWidth="720">
                <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True"/>

                <TextBlock Text="Export" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0"/>
                <TextBlock Text="Writes a file in the original Obtainium export format, so it can be imported by Obtainium on Android or by this app."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="ExportLevelCombo" Header="What to include" MinWidth="320" SelectedIndex="1">
                    <ComboBoxItem Content="Apps only"/>
                    <ComboBoxItem Content="Apps and settings (credentials stripped)"/>
                    <ComboBoxItem Content="Apps and settings, including credentials"/>
                </ComboBox>
                <Button Content="Export to file..." Click="Export_Click" HorizontalAlignment="Left"/>
                <ToggleSwitch x:Name="InstalledOnlyToggle" Header="Only include installed apps in exports" Toggled="InstalledOnlyToggle_Toggled"/>
                <ToggleSwitch x:Name="AutoExportToggle" Header="Automatically export on changes" Toggled="AutoExportToggle_Toggled"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="AutoExportPathBox" Header="Auto-export file path" PlaceholderText="C:\Users\you\Documents\obtainium-export.json" LostFocus="AutoExportPathBox_LostFocus" Width="420"/>
                    <Button Content="Browse..." Click="AutoExportBrowse_Click" VerticalAlignment="Bottom"/>
                </StackPanel>

                <TextBlock Text="Import" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,20,0,0"/>
                <TextBlock Text="Reads an Obtainium export file (schema v2 and legacy formats). Apps with an existing ID are replaced; new apps are added."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button Content="Import from file..." Click="Import_Click" HorizontalAlignment="Left"/>

                <TextBlock Text="Import from URL list" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,20,0,0"/>
                <TextBlock Text="One app source URL per line. Each is checked and added; failures are reported per URL."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="UrlListBox" PlaceholderText="https://github.com/owner/repo&#x0a;https://..." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="UrlFileButton" Content="From file..." Click="ImportUrlFile_Click" VerticalAlignment="Center"/>
                    <Button x:Name="UrlImportButton" Content="Import URLs" Click="ImportUrls_Click"/>
                    <ProgressRing x:Name="UrlImportRing" IsActive="False" Width="18" Height="18" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Bulk import" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,20,0,0"/>
                <TextBlock Text="Import apps in bulk from an external list. You review and pick which repos to add before anything is saved."
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="StarsUsernameBox" PlaceholderText="GitHub username" Width="220" VerticalAlignment="Center"/>
                    <Button Content="Import GitHub starred repos..." Click="ImportStars_Click" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
