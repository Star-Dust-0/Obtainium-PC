<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ObtainiumPC.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="2">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Appearance, update behavior and sources." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,12,0,0" SizeChanged="Split_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SectionNavColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListView x:Name="SectionList" SelectionMode="Single" SelectionChanged="SectionList_SelectionChanged" Visibility="Collapsed" VerticalAlignment="Top"/>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SectionHost" Spacing="0" HorizontalAlignment="Left">
                <Border x:Name="SecAppearance" CornerRadius="8" BorderThickness="1" Padding="16,12,16,16" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <ComboBox x:Name="ThemeCombo" Header="Theme" MinWidth="260" SelectionChanged="ThemeCombo_SelectionChanged"/>
                <ComboBox x:Name="LanguageCombo" Header="Language" MinWidth="260" SelectionChanged="LanguageCombo_SelectionChanged"/>
                <ComboBox x:Name="SortByCombo" Header="Sort apps by" MinWidth="260" SelectionChanged="SortByCombo_SelectionChanged"/>
                <ComboBox x:Name="SortOrderCombo" Header="Sort order" MinWidth="260" SelectionChanged="SortOrderCombo_SelectionChanged"/>
                <ComboBox x:Name="DensityCombo" Header="App list density" MinWidth="260" SelectionChanged="DensityCombo_SelectionChanged"/>
                <ToggleSwitch x:Name="PinUpdatesToggle" Header="Pin apps with updates to the top" Toggled="PinUpdatesToggle_Toggled"/>
                <ToggleSwitch x:Name="BuryNonInstalledToggle" Header="Move apps not yet installed to the bottom" Toggled="BuryNonInstalledToggle_Toggled"/>
                <ComboBox x:Name="GroupByCombo" Header="Group apps by" MinWidth="260" SelectionChanged="GroupByCombo_SelectionChanged"/>
                <ToggleSwitch x:Name="CollapseGroupsToggle" Header="Collapse all groups on app start" Toggled="CollapseGroupsToggle_Toggled"/>
                    </StackPanel>
                </Border>
                <Border x:Name="SecUpdates" CornerRadius="8" BorderThickness="1" Padding="16,12,16,16" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                <TextBlock Text="Updates" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <ComboBox x:Name="UpdateIntervalCombo" Header="Background update interval" MinWidth="260" SelectionChanged="UpdateIntervalCombo_SelectionChanged"/>
                <ComboBox x:Name="MinAgeCombo" Header="Minimum age for updates (global default)" MinWidth="260" SelectionChanged="MinAgeCombo_SelectionChanged"/>
                <ToggleSwitch x:Name="CheckOnStartToggle" Header="Check for updates on app start" Toggled="CheckOnStartToggle_Toggled"/>
                <ToggleSwitch x:Name="SkipMeteredToggle" Header="Don't check on a metered connection" Toggled="SkipMeteredToggle_Toggled"/>
                <ToggleSwitch x:Name="SkipBatteryToggle" Header="Don't check on battery power" Toggled="SkipBatteryToggle_Toggled"/>
                <TextBlock Text="Applies to background checks only. Pressing Check for updates always runs." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ToggleSwitch x:Name="HandleLinksToggle" Header="Open Obtainium links (obtainium://) with Obtainium-PC" Toggled="HandleLinksToggle_Toggled"/>
                <ToggleSwitch x:Name="NotifyToggle" Header="Show update notifications" Toggled="NotifyToggle_Toggled"/>
                <ToggleSwitch x:Name="HideDowngradesToggle" Header="Hide downgrades (when installed version is newer)" Toggled="HideDowngradesToggle_Toggled"/>
                <!-- en.json checkUpdateOnDetailPage / onlyCheckInstalledOrTrackOnlyApps /
                     includePrereleasesByDefault / dontShowTrackOnlyWarnings -->
                <ToggleSwitch x:Name="CheckUpdateOnDetailToggle" Header="Check for updates on opening an app detail page" Toggled="CheckUpdateOnDetailToggle_Toggled"/>
                <ToggleSwitch x:Name="OnlyCheckInstalledToggle" Header="Only check installed and track-only apps for updates" Toggled="OnlyCheckInstalledToggle_Toggled"/>
                <ToggleSwitch x:Name="PrereleasesDefaultToggle" Header="Include pre-releases by default" Toggled="PrereleasesDefaultToggle_Toggled"/>
                <ToggleSwitch x:Name="HideTrackOnlyWarningToggle" Header="Don't show 'track-only' warnings" Toggled="HideTrackOnlyWarningToggle_Toggled"/>
                <!-- en.json showAppDowngradeError / skipBulkUpdateConfirmation /
                     parallelDownloads / enableCertificatePinning -->
                <ToggleSwitch x:Name="ShowDowngradeErrorToggle" Header="Show app downgrade errors" Toggled="ShowDowngradeErrorToggle_Toggled"/>
                <ToggleSwitch x:Name="SkipBulkConfirmToggle" Header="Skip update/install confirmation dialog" Toggled="SkipBulkConfirmToggle_Toggled"/>
                <ToggleSwitch x:Name="ParallelDownloadsToggle" Header="Allow parallel downloads" Toggled="ParallelDownloadsToggle_Toggled"/>
                <ToggleSwitch x:Name="CertPinningToggle" Header="Enable certificate pinning" Toggled="CertPinningToggle_Toggled"/>
                <ToggleSwitch x:Name="AddWithoutCheckToggle" Header="Offer to add apps without a version check when the source fails" Toggled="AddWithoutCheckToggle_Toggled"/>
                    </StackPanel>
                </Border>
                <Border x:Name="SecVersion" CornerRadius="8" BorderThickness="1" Padding="16,12,16,16" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                <TextBlock Text="Version detection (global defaults)" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBox x:Name="GlobalVersionRegexBox" Header="Trim version string with RegEx" TextWrapping="Wrap" LostFocus="GlobalVersionRegexBox_LostFocus"/>
                <TextBox x:Name="GlobalMatchGroupBox" Header="Match group to use" PlaceholderText="$0" Width="160" HorizontalAlignment="Left" LostFocus="GlobalMatchGroupBox_LostFocus"/>
                <TextBox x:Name="GlobalAssetFilterBox" Header="Filter assets by regular expression (global default)" TextWrapping="Wrap" LostFocus="GlobalAssetFilterBox_LostFocus"/>
                    </StackPanel>
                </Border>
                <Border x:Name="SecGitHub" CornerRadius="8" BorderThickness="1" Padding="16,12,16,16" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                <TextBlock Text="GitHub" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <PasswordBox x:Name="GitHubPatBox" Header="Personal access token (raises API rate limits)" Width="360" HorizontalAlignment="Left" LostFocus="GitHubPatBox_LostFocus"/>
                <ToggleSwitch x:Name="RepoRenameToggle" Header="Detect renamed repositories" Toggled="RepoRenameToggle_Toggled"/>
                <TextBox x:Name="GhReqPrefixBox" Header="Request prefix (for GitHub proxies)" TextWrapping="Wrap" LostFocus="GhReqPrefixBox_LostFocus"/>
                    </StackPanel>
                </Border>
                <Border x:Name="SecCategories" CornerRadius="8" BorderThickness="1" Padding="16,12,16,16" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                <TextBlock Text="Categories" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="Categories are created when you categorize apps. Deleting one removes it from every app. Switch on Skip update checks to leave a category out of update checks." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ItemsRepeater x:Name="CategoryList">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                <Ellipse Width="14" Height="14" Fill="{Binding Swatch}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MinWidth="120"/>
                                <TextBlock Text="Skip update checks" VerticalAlignment="Center"/>
                                <ToggleSwitch IsOn="{Binding Excluded}" Tag="{Binding Name}" Toggled="SkipChecksToggle_Toggled" OnContent="On" OffContent="Off" MinWidth="0"/>
                                <Button Content="Delete" Tag="{Binding Name}" Click="DeleteCategory_Click" FontSize="12" Padding="8,2"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                    </StackPanel>
                </Border>
                <Border x:Name="SecAbout" CornerRadius="8" BorderThickness="1" Padding="16,12,16,16" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock Text="Obtainium-PC - a native Windows port of Obtainium by ImranR98, licensed GPL-3.0. Brought to you by Instinct." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <HyperlinkButton Content="Upstream Obtainium (ImranR98)" NavigateUri="https://github.com/ImranR98/Obtainium"/>
                <HyperlinkButton Content="Obtainium-PC source (this fork)" NavigateUri="https://github.com/MohamedElnaggar00/Obtainium-PC"/>
                <HyperlinkButton Content="GPL-3.0 license" NavigateUri="https://github.com/ImranR98/Obtainium/blob/main/LICENSE.md"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</Page>
