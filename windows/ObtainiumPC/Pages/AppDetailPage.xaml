<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ObtainiumPC.Pages.AppDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24,16,24,16">
        <ScrollViewer>
            <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Grid Width="48" Height="48" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xECAA;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Image x:Name="AppIconImage" Stretch="UniformToFill"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock x:Name="AuthorText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <CommandBar x:Name="DetailCommandBar" DefaultLabelPosition="Right" Background="Transparent" HorizontalAlignment="Left" Margin="-12,0,0,0">
                    <!-- Upstream lib/pages/app.dart:469-471: the detail app bar
                         leads with a BackButton (the apps flow always passes
                         onClose; upstream renders it icon-only, so there is no
                         translatable label). Returns to the list without
                         relying on the nav rail. -->
                    <AppBarButton x:Name="BackButton" AutomationProperties.Name="Back" Click="Back_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE72B;"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="UpdateButton" Label="Update" Click="Update_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE777;"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="InstallButton" Label="Install" Click="Update_Click" Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8B5;"/></AppBarButton.Icon>
                    </AppBarButton>
                    <!-- Track-only apps only download (upstream lib/pages/app.dart marks them
                         installed/updated; the port keeps the authorized manual download flow,
                         so the action must not promise installation). -->
                    <AppBarButton x:Name="DownloadButton" Label="Download" Click="Update_Click" Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE896;"/></AppBarButton.Icon>
                    </AppBarButton>
                    <!-- Upstream lib/pages/app.dart:508/511: the track-only primary action is
                         markInstalled/markUpdated (version bookkeeping only). The port keeps
                         that action alongside the manual-download button. -->
                    <AppBarButton x:Name="MarkInstalledAction" Label="Mark installed" Click="MarkTrackOnly_Click" Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE73E;"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="MarkUpdatedAction" Label="Mark updated" Click="MarkTrackOnly_Click" Visibility="Collapsed">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE73E;"/></AppBarButton.Icon>
                    </AppBarButton>
                    <!-- A freshly-shown disabled AppBarButton keeps the
                         enabled visual state whether IsEnabled was set in
                         code or baked in XAML while collapsed (stale
                         CommonStates on first template, same family as
                         40139280718; 28h pixel review on run 40186712354:
                         label luminance 243 vs 116 for a real disabled
                         button). Local Foreground values beat visual-state
                         setters, so the disabled twin pins the disabled
                         brush explicitly on label and icon. -->
                    <AppBarButton x:Name="MarkUpdatedDisabledAction" Label="Mark updated" Visibility="Collapsed" IsEnabled="False"
                                  Foreground="{ThemeResource TextFillColorDisabledBrush}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource TextFillColorDisabledBrush}"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Options" Click="Options_Click" ToolTipService.ToolTip="Per-app options">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE70F;"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="OsSettingsButton" Label="App settings" Click="OsSettings_Click"
                                  ToolTipService.ToolTip="Windows app settings (packaged installs only)">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE713;"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="ResetInstallButton" Label="Reset install status" Click="ResetInstall_Click"
                                  ToolTipService.ToolTip="Forget the recorded install so the app can be installed again">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE777;"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton x:Name="TrackButton" Label="Disable tracking" Click="Track_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xF140;"/></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Remove" Click="Remove_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>

                <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" Message=""/>

                <!-- lib/pages/app.dart _buildRepoRenameSection -->
                <InfoBar x:Name="RenameBar" IsOpen="False" Severity="Warning" Title="Repository renamed" IsClosable="False">
                    <StackPanel Spacing="8">
                        <TextBlock Text="The source reports this repository moved. Review the new URL, then update or dismiss." TextWrapping="Wrap"/>
                        <TextBlock x:Name="RenameUrlText" TextWrapping="Wrap" FontWeight="SemiBold" IsTextSelectionEnabled="True"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Update URL" Click="RenameAccept_Click"/>
                            <Button Content="Dismiss" Click="RenameDismiss_Click"/>
                        </StackPanel>
                    </StackPanel>
                </InfoBar>

                <Border x:Name="VersionCard" CornerRadius="8" BorderThickness="1" Padding="16,12,16,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="VersionNoteText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontStyle="Italic" Visibility="Collapsed"/>
                        <TextBlock x:Name="InstalledText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="LatestText" TextWrapping="Wrap"/>
                        <HyperlinkButton x:Name="ReleaseDateLink" Click="ReleaseDate_Click" Visibility="Collapsed" Padding="0">
                            <TextBlock x:Name="ReleaseDateText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </HyperlinkButton>
                        <HyperlinkButton x:Name="ReleaseLink" Content="Open release page" Click="ReleaseLink_Click"/>
                        <HyperlinkButton x:Name="HealthLink" Content="Update health: view details" Click="HealthLink_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="DownloadPanel" Spacing="6" Visibility="Collapsed">
                    <ProgressBar x:Name="DownloadBar" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="Download progress"/>
                    <TextBlock x:Name="DownloadText" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel x:Name="PostDownloadPanel" Spacing="6" Visibility="Collapsed">
                    <TextBlock x:Name="PostDownloadNote" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DetectNowButton" Content="Detect installed version now" Click="DetectNow_Click"/>
                        <Button x:Name="MarkUpdatedButton" Content="Mark as updated" Click="MarkUpdated_Click"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
