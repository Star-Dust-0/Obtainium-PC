<Page
    x:Class="ObtainiumPC.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12" Padding="24,16,24,16" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Logs" Style="{ThemeResource TitleTextBlockStyle}"/>
                <TextBlock Text="Update checks, downloads and errors." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <ComboBox x:Name="DaysCombo" SelectedIndex="0" SelectionChanged="DaysCombo_SelectionChanged" VerticalAlignment="Center">
                <ComboBoxItem Content="Last 7 days" Tag="7"/>
                <ComboBoxItem Content="Last 5 days" Tag="5"/>
                <ComboBoxItem Content="Last 4 days" Tag="4"/>
                <ComboBoxItem Content="Last 3 days" Tag="3"/>
                <ComboBoxItem Content="Last 2 days" Tag="2"/>
                <ComboBoxItem Content="Last day" Tag="1"/>
            </ComboBox>
            <Button Content="Copy all" Click="Copy_Click" VerticalAlignment="Center"/>
            <Button Content="Share" Click="Share_Click" VerticalAlignment="Center"/>
            <Button Content="Clear logs" Click="Clear_Click" VerticalAlignment="Center"/>
            <ProgressRing x:Name="BusyRing" IsActive="False" Width="18" Height="18" VerticalAlignment="Center"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Padding="24,0,24,16">
            <StackPanel>
                <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="EmptyState" Text="No logs in this period." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                <ItemsRepeater x:Name="LogsList"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
