<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ObtainiumPC.Pages.EmptyDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
        <FontIcon Glyph="&#xE71D;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
        <TextBlock x:Name="HintText" Text="Select an app to see its details." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
</Page>
