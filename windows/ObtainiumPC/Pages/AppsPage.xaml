<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ObtainiumPC.Pages.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ObtainiumPC.Pages">
    <Page.Resources>
        <DataTemplate x:Key="GroupHeaderTemplate" x:DataType="local:GroupHeaderRow">
            <Grid Padding="12,10,12,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind ChevronGlyph}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{x:Bind CountText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AppRowTemplate" x:DataType="local:AppRow">
                    <Grid Padding="{x:Bind RowPadding}" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center" HorizontalAlignment="Left" Width="{x:Bind IconBox}" Height="{x:Bind IconBox}">
                            <FontIcon Glyph="&#xECAA;" FontSize="{x:Bind IconSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Image Source="{x:Bind IconSource}" Stretch="UniformToFill"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind Subtitle}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind CategoriesText}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind CategoriesVisibility}"/>
                            <TextBlock Text="{x:Bind Status}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind StatusVisibility}"/>
                        </StackPanel>
                    </Grid>
        </DataTemplate>
        <local:AppsRowTemplateSelector x:Key="RowSelector" AppTemplate="{StaticResource AppRowTemplate}" GroupTemplate="{StaticResource GroupHeaderTemplate}"/>
    </Page.Resources>
    <Grid x:Name="SplitRoot" SizeChanged="SplitRoot_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MasterColumn" Width="*"/>
            <ColumnDefinition x:Name="DetailColumn" Width="0"/>
        </Grid.ColumnDefinitions>
    <Grid x:Name="MasterGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12" Padding="24,16,24,8" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Apps" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="RefreshButton" ToolTipService.ToolTip="Check for updates" Click="Refresh_Click" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
            </Button>
            <ProgressRing Grid.Column="2" x:Name="BusyRing" IsActive="False" Width="18" Height="18" VerticalAlignment="Center"/>
            <ToggleButton Grid.Column="4" x:Name="SelectToggle" Content="Select" Checked="SelectToggle_Changed" Unchecked="SelectToggle_Changed" VerticalAlignment="Center"/>
        </Grid>
        <Grid x:Name="SearchRow" Grid.Row="1" Padding="24,0,24,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" MinWidth="120" PlaceholderText="Search apps" TextChanged="SearchBox_TextChanged" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            <ToggleButton Grid.Column="1" x:Name="UpdatesOnlyToggle" Content="Updates only" Checked="FilterChanged" Unchecked="FilterChanged" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="2" x:Name="CategoryCombo" MinWidth="110" SelectionChanged="CategoryCombo_SelectionChanged" VerticalAlignment="Center"/>
            <Button Grid.Column="3" x:Name="FilterButton" Content="Filter" Click="Filter_Click" VerticalAlignment="Center"/>
        </Grid>
        <ListView x:Name="AppsList" Grid.Row="2" ItemsSource="{x:Bind Rows}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="AppsList_ItemClick" Padding="24,4,24,16" ItemTemplateSelector="{StaticResource RowSelector}">

        </ListView>
        <TextBlock x:Name="EmptyState" Grid.Row="2" Text="No apps yet. Use Add App to track your first app." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
        <CommandBar x:Name="BatchBar" Grid.Row="2" VerticalAlignment="Bottom" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <AppBarButton x:Name="BatchPinButton" Label="Pin" Click="BatchPin_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE718;"/></AppBarButton.Icon></AppBarButton>
            <AppBarButton x:Name="BatchDisableButton" Label="Disable" Click="BatchDisable_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE71A;"/></AppBarButton.Icon></AppBarButton>
            <AppBarButton x:Name="BatchMarkButton" Label="Mark updated" Click="BatchMark_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE73E;"/></AppBarButton.Icon></AppBarButton>
            <AppBarButton x:Name="BatchCopyUrlsButton" Label="Copy URLs" Click="BatchCopyUrls_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE8C8;"/></AppBarButton.Icon></AppBarButton>
            <AppBarButton x:Name="BatchDownloadButton" Label="Download updates" Click="BatchDownload_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE896;"/></AppBarButton.Icon></AppBarButton>
            <AppBarButton x:Name="BatchExportButton" Label="Export" Click="BatchExport_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE74E;"/></AppBarButton.Icon></AppBarButton>
            <AppBarButton x:Name="BatchCopyConfigsButton" Label="Copy config links" Click="BatchCopyConfigs_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE71B;"/></AppBarButton.Icon></AppBarButton>
            <AppBarButton x:Name="BatchCategorizeButton" Label="Categorize" Click="BatchCategorize_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE8EC;"/></AppBarButton.Icon></AppBarButton>
            <AppBarButton x:Name="BatchRemoveButton" Label="Remove" Click="BatchRemove_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE74D;"/></AppBarButton.Icon></AppBarButton>
        </CommandBar>
    </Grid>
        <Frame x:Name="DetailFrame" Grid.Column="1" Visibility="Collapsed"/>
    </Grid>
</Page>
