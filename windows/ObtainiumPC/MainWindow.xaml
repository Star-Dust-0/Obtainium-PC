<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ObtainiumPC.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:ObtainiumPC">
    <muxc:NavigationView
        x:Name="NavView"
        PaneDisplayMode="Left"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="NavView_SelectionChanged"
        Loaded="NavView_Loaded">
        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem Content="Apps" Tag="apps">
                <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE71D;"/></muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Add App" Tag="addapp">
                <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE710;"/></muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Import / Export" Tag="importexport">
                <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE8CB;"/></muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="Settings" Tag="settings">
                <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.MenuItems>
        <Frame x:Name="ContentFrame"/>
    </muxc:NavigationView>
</Window>
